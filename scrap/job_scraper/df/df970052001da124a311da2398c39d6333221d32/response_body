                                <span id="lblDepartmentName">CA Science Center</span>
                            </p>

                        </div>
                        <div style="text-align: left;">
                            <div>
                                <div style="display: inline-table; vertical-align: text-top;">
                                    JC-454948
                                </div>
                                -
                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Police Officer at Office of Exposition Park - LATERAL</span>
                                    
                                        <br />
                                        EXPOSITION POLICE OFFICER
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$5,160.00 - $6,138.00 per Month</span>
                            </p>
                            <p style="font-weight: bold;">
                                Final Filing Date:
                        <span id="lblFinalFilingDate">Until Filled</span>
                            </p>
