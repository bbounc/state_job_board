                <h3 class="postingHeader">Position Details</h3>
                <div class="postingContent">

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Job Code #:</strong>
                        </div>
                        <div class="col">
                            <span id="lblDetailsJobControlNumber">JC-458572</span>
                        </div>
                    </div>

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Position #(s):</strong>
                        </div>
                        <div class="col">
                            
                                    <div>542-116-1757-VAR</div>
                                
                        </div>
                    </div>

                    <div id="rowWorkingTitle">
		
                        <div>
                            <div class="wHeaderCol col">
                                <strong>Working Title:</strong>
