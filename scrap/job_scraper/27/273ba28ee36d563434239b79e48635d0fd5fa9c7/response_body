                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Fire Captain - Paramedic</span>
                                    
                                        <br />
                                        FIRE CAPTAIN (PARAMEDIC)
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$6,199.00 - $8,033.00 per Month</span>
