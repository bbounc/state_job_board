        <div class="jcBand">

            
                <div class="col col-half">
                    <h3 class="postingHeader">Minimum Requirements</h3>

                    <span id="lblMinimumReqsInClassSpec">You will find the Minimum Requirements in the Class Specification.</span><ul><li><a href='https://hrnet.calhr.ca.gov/CalHRNet/SpecCrossReference.aspx?ClassID=1954' target='_blank'>PEACE OFFICER I, DEVELOPMENTAL CENTER</a></li></ul>
