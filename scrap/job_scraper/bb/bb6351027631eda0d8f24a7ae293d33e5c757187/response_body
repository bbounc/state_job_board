    <div id="pnlContactInformation" class="jcBand">
	
        <h3 class="postingHeader">Contact Information</h3>
        <div class="postingContent">
            <p>
                The Human Resources Contact is available to answer questions regarding the application process.  The Hiring Unit Contact is available to answer questions regarding the position.
            </p>

            
            <div id="rowHRContact" class="paddingTop10">
                <span style="font-weight:bold;">Human Resources Contact: </span><br />
                <span id="lblHRContactName">Kendra Walker</span><br />
                <span id="lblHRContactNumber">(858) 472-6503</span><br />
                <span id="lblHRContactEmail">Kendra.Walker@dot.ca.gov</span>
            </div>
            <div id="rowHUContact" class="paddingTop10">
                <span style="font-weight:bold;">Hiring Unit Contact: </span><br />
                <span id="lblHiringUnitContactName">Maria Elena Capati-Palo</span><br />
                <span id="lblHiringUnitContactNumber">(619) 929-6988</span><br />
                <span id="lblHiringUnitEmail">Maria.Capati-Palo@dot.ca.gov</span>
            </div>
