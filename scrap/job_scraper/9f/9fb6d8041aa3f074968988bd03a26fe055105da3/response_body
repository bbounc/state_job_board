        <div class="jcBand">

            
                <div class="col col-half">
                    <h3 class="postingHeader">Minimum Requirements</h3>

                    <span id="lblMinimumReqsInClassSpec">You will find the Minimum Requirements in the Class Specification.</span><ul><li><a href='https://hrnet.calhr.ca.gov/CalHRNet/SpecCrossReference.aspx?ClassID=9218' target='_blank'>DISABILITY INSURANCE SPECIALIST I</a></li><li><a href='https://hrnet.calhr.ca.gov/CalHRNet/SpecCrossReference.aspx?ClassID=9227' target='_blank'>DISABILITY INSURANCE SPECIALIST II</a></li></ul>
                </div>
            

