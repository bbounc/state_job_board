                                -
                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Physical Therapist II</span>
                                    
                                        <br />
                                        PHYSICAL THERAPIST II
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$6,053.00 - $9,007.00 per Month</span>
                            </p>
                            <p style="font-weight: bold;">
                                Final Filing Date:
                        <span id="lblFinalFilingDate">Until Filled</span>
                            </p>
