        <div class="jcBand">

            <div id="pnlPositionDetails" class="col col-half " style="vertical-align: top;">
	
                <h3 class="postingHeader">Position Details</h3>
                <div class="postingContent">

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Job Code #:</strong>
                        </div>
                        <div class="col">
                            <span id="lblDetailsJobControlNumber">JC-451467</span>
                        </div>
