                ecos.site.search();
                $('.glossaryItemPopupClose').click(function () {
                    $('#glossaryItemPopup').popup('hide');
                });

            });

            function applyResponsiveTabs() {
                // responsive tabs for the My Account section
                if ($('.ecos-my-account-nav').length) {
                    ecos.myAccount.tabsResponsive();
                }

                $('input:file').attr('title', 'file upload control');
            }

            function applyGlossaryItem() {
                $('.glossaryItem').click(function (event) {
                    var item = $(event.target);
                    var itemTerm = item.html();

                    if (item.attr('glossary-Term') != undefined)
                        itemTerm = item.attr('glossary-Term');

                    //just in case it fails later
                    $('#glossaryItemPopupHeader').html(itemTerm);
                    $('#glossaryItemPopupContent').html('Unable to find additional information on the provided term.');

                    var siteRoot = '';

					$.when(
						$.ajax({
							type: "GET",
							async: false,
							url: siteRoot + "/api/glossary/getglossaryitembytext?glossaryterm=" + itemTerm,
							contentType: "application/json; charset=utf-8",
							dataType: "json",
							success: function (msg) {
								//console.log(msg);
							}
						})
					).done(function (data) {
						$('#glossaryItemPopupHeader').html(data.Term);
						$('#glossaryItemPopupContent').html(data.Definition);
					})
						;

					$('#glossaryItemPopup').popup({
						//type: 'overlay',
						type: 'tooltip',
						vertical: 'bottom',
						horizontal: 'right',
						transition: '0.2s all 0.1s',
						autoopen: 'true',
						tooltipanchor: event.target,
						//opacity: .5,
						offsetleft: 10,
						offsettop: -20
					});

				});
			}

            //Accessibility cleanup on certain controls
            function applyAccessibilityToDevxItems() {

                setTimeout(function () {

                    $('.devxpressItem ').find('input').each(function (e, sender) {

                        var elem = $(sender)[0];

                        document.getElementById(elem.id).title = 'new title';

                    });

                    $('[role="application"]').each(function (e, sender) {
                        var elem = $(sender)[0];
                        $(elem).attr('aria-labelledby', 'application');

                    });

                }

                    , 500)
            };//settimeout

            function scrollToTop(topOffset) {

                topOffset = typeof topOffset !== 'undefined' ? topOffset : 200;

                $('html,body').animate({
                    scrollTop: topOffset
                }, 400, function () {
                    $(window).scroll()
                });
            }

            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": false,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            }

        </script>

