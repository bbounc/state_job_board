                <ul><li><a href='http://calcareers.ca.gov/CalHrPublic/Jobs/JobApplicationPackageChecklist.aspx?JobControlId=448022'>Job Application Package Checklist</a></li><li><a href='https://www.CalCareers.ca.gov/CalHrPublic/FileDownload.aspx?aid=25931381&name=CEODutyStatement-SOL12.18.2024.pdf'>Duty Statement</a></li></ul>

            </div>

        </div>

        <div class="jcBand">

