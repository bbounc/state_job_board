                                <div style="display: inline-table; vertical-align: text-top;">
                                    JC-464004
                                </div>
                                -
                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Correctional Supervising Cook, CF - Salinas Valley State Prison (SVSP)</span>
                                    
                                        <br />
                                        CORRECTIONAL SUPERVISING COOK (CORRECTIONAL FACILITY)
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$4,452.00 - $5,475.00 per Month</span>
                            </p>
                            <p style="font-weight: bold;">
                                Final Filing Date:
                        <span id="lblFinalFilingDate">Until Filled</span>
                            </p>
