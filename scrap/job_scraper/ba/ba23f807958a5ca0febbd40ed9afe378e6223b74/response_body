                <div class="col jcHead">
                    <p class="primaryPostingHeader" style="margin-left: 50px;">
                        Job Posting:
                    Wildfire Resilience Forester I
                    </p>

                </div>
                <div class="col col-twothirds jcHead-LeftPane">

                    <div class="col stateSealLogo">
                        <div>
                            
                            <img src="data:image/jpeg;base64," alt="State Seal Logo" />
                        </div>

                    </div>

                    <div id="pnlBannerSection" class="col" style="vertical-align: top; margin-left: 50px;">
	

                        <div style="text-align: left; max-width: 500px;">
                            <p class="secondaryPostingHeader">
                                <span id="lblDepartmentName">Department of Forestry & Fire Protection</span>
                            </p>

                        </div>
                        <div style="text-align: left;">
                            <div>
                                <div style="display: inline-table; vertical-align: text-top;">
                                    JC-454669
                                </div>
                                -
                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Wildfire Resilience Forester I</span>
                                    
                                        <br />
                                        FORESTER I (NONSUPERVISORY)
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$6,233.00 - $8,090.00 per Month</span>
                            </p>
                            <p style="font-weight: bold;">
                                Final Filing Date:
                        <span id="lblFinalFilingDate">Until Filled</span>
                            </p>
                        </div>
                    
</div>
