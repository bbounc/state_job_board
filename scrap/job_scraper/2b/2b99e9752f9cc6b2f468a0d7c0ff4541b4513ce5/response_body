                                -
                                <div style="display: inline-table; max-width: 400px; text-wrap: normal;">
                                    <span id="lblWorkingTitleHeader">Fire/EMS Dispatcher</span>
                                    
                                        <br />
                                        COMMUNICATIONS OPERATOR
                                </div>
                            </div>

                            <p>
                                <span id="lblPrimarySalary">$4,598.00 - $7,163.00 per Month</span>
                            </p>
                            <p style="font-weight: bold;">
                                Final Filing Date:
                        <span id="lblFinalFilingDate">Until Filled</span>
                            </p>
                        </div>
                    
</div>
