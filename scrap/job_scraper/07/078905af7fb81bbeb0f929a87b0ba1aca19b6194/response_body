	<li><span style="font-size:12.0pt"><span><span style="font-family:&#39;Times New Roman&#39;, serif"><span style="font-size:11.0pt"><span style="font-family:&#39;Arial&#39;, sans-serif"><span style="color:black">Notify state attorney, law enforcement and child protection teams;</span></span></span></span></span></span></li>
