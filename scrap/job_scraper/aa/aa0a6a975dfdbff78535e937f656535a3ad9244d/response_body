        <div class="jcBand">

            
                <div class="col col-half">
                    <h3 class="postingHeader">Minimum Requirements</h3>

                    <span id="lblMinimumReqsInClassSpec">You will find the Minimum Requirements in the Class Specification.</span><ul><li><a href='https://hrnet.calhr.ca.gov/CalHRNet/SpecCrossReference.aspx?ClassID=4159' target='_blank'>ASSOCIATE MANAGEMENT AUDITOR</a></li><li><a href='https://hrnet.calhr.ca.gov/CalHRNet/SpecCrossReference.aspx?ClassID=5841' target='_blank'>STAFF SERVICES MANAGEMENT AUDITOR</a></li></ul>
                </div>
            

