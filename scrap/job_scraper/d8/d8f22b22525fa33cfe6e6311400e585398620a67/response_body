                <div class="postingContent">

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Job Code #:</strong>
                        </div>
                        <div class="col">
                            <span id="lblDetailsJobControlNumber">JC-455709</span>
                        </div>
                    </div>

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Position #(s):</strong>
                        </div>
                        <div class="col">
                            
                                    <div>311-440-1405-003</div>
                                
                        </div>
                    </div>

                    <div id="rowWorkingTitle">
		
                        <div>
                            <div class="wHeaderCol col">
                                <strong>Working Title:</strong>
                            </div>
                            <div class="col" style="max-width: 450px;">
                                <strong>
