        <script type="text/javascript">
            //Session Timeout Code
            var securedPage = false;

            if (securedPage) {
                myVar = window.setInterval(updateTimeout, 1000);
            }

            var showWarningAtMinutesLeft = 5;

            function updateTimeout() {

                var cd = $('#ucSessionTimeoutDialog_tmrCountdown');
                var currentVal = cd.attr('value') - 1;

                var date = new Date(null);
                date.setSeconds(currentVal);
                var timeText = date.toISOString().substr(14, 5);

                var suffix = 'Minutes';
                if (currentVal < 120) suffix = 'Minute';
                if (currentVal < 60) suffix = 'Seconds';
                if (currentVal == 1) suffix = 'Second';

                if (currentVal > 0) {
                    timeText = timeText.toString() + ' ' + suffix;

                    $('#SessionTime').text(timeText);
                    $('#SessionTime2').text(timeText);

                    if (currentVal <= showWarningAtMinutesLeft * 60) {
                        $("#main-content").css('opacity', 0.4);
                        $('#TimerMask').show();
                        $("#ucSessionTimeoutDialog_btnStayLoggedIn").focus();
                    }

                    cd.val(currentVal);
                }
                else if (currentVal == 0) {
                    timeText = 'Logging out ...';

                    $('#SessionTime').text(timeText);
                    $('#SessionTime2').text(timeText);

                    window.location = 'https://www.calcareers.ca.gov/CalHrSecured/Logout.aspx';
                }
            }
        </script>

    
