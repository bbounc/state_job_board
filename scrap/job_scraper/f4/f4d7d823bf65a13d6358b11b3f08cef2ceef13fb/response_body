                <div class="postingContent">

                    <div>
                        <div class="wHeaderCol col">
                            <strong>Job Code #:</strong>
                        </div>
                        <div class="col">
                            <span id="lblDetailsJobControlNumber">JC-457288</span>
                        </div>
                    </div>

